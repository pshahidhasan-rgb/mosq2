# ==============================================================================
# MosqAI Environment Configuration Template (.env.example)
# ==============================================================================

PORT=3000

# 0. Soniox Real-Time Speech Translation (Primary Engine — Sub-200ms Dynamic Language Gates)
# Sign up at: https://console.soniox.com/signup ($0.18/hr per active language stream)

# 1. Deepgram Real-Time Speech-to-Text (Nova-3 Arabic Audio STT)
# Sign up at: https://console.deepgram.com ($200 free credits, no card required)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 2. OpenRouter API Key (Open-Weights Models for Translation & Quran AI Detection)
# Sign up at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Open-Weight Model (Cheap, high quality, not closed-weights):
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. DeepL API Free Tier (Optional: 500k chars/mo free)
# Sign up at: https://www.deepl.com/pro-api
DEEPL_API_KEY=your_deepl_api_key_here

# 4. Gladia Real-Time Speech-to-Text (Secondary fallback STT)
# Sign up at: https://app.gladia.io
GLADIA_API_KEY=your_gladia_api_key_here

# 5. Cartesia AI Sonic (Low-Latency Multilingual Voice for Earbuds)
# Sign up at: https://play.cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key_here

# Mosque Defaults
DEFAULT_MASJID_NAME=Masjid Al-Noor
DEFAULT_PRIMARY_LANGUAGE=en
